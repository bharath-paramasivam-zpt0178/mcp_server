        },
        "outputSchema" : {
          "properties" : {
            "data" : {
              "type" : "object"
            },
            "status" : {
              "enum" : [ "failure", "success" ],
              "type" : "string"
            }
          },
          "type" : "object"
        }
      },
      "call" : { },
      "call_handler" : { }
    },
    "path" : "/api/v1/paymentsessions/{payments_session_id}",
