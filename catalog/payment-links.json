                  "type" : "number"
                },
                "currency" : {
                  "description" : "The currency of the payment amount, represented by a 3-letter ISO currency code.",
                  "type" : "string"
                },
                "description" : {
                  "description" : "The description of the payment link. The maximum length of the description can be 500 characters.",
                  "type" : "string"
                },
                "email" : {
                  "description" : "Email address of the customer.",
                  "type" : "string"
                },
                "expires_at" : {
                  "description" : "Expiration date of the payment link (yyyy-MM-dd). Default 30 days if not set.",
                  "type" : "string"
                },
                "notify_customer" : {
                  "description" : "Specifies the notification channels to be used for notifying the customer.",
                  "properties" : {
                    "email" : {
                      "description" : "Indicates whether a notification email should be sent to the customer.",
                      "type" : "boolean"
                    }
                  },
                  "type" : "object"
                },
                "notify_user" : {
                  "description" : "Deprecated. Use notify_customer.email to notify the customer.",
                  "type" : "boolean"
                },
                "phone" : {
                  "description" : "The phone number associated with the payment link.",
                  "type" : "string"
                },
                "reference_id" : {
                  "description" : "An alphanumeric identifier that helps in identifying the payment. The maximum length can be 100 characters.",
                  "type" : "string"
                },
                "return_url" : {
                  "description" : "URL to redirect the customer after a successful payment. Return URL includes query parameters with payment info. See Zoho Payments developer docs for signature verification.",
                  "type" : "string"
                }
              },
              "required" : [ "amount", "description", "currency" ],
              "type" : "object"
            },
            "query_params" : {
              "properties" : {
                "account_id" : {
                  "description" : "The Zoho Payments account ID.",
                  "type" : "string"
                }
